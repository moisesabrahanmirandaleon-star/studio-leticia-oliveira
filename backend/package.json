{
  "name": "studio-beleza-backend",
  "version": "1.0.0",
  "description": "Backend API para Studio de Beleza / Sobrancelhas",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepareSchema.js",
    "dev": "node scripts/prepareSchema.js && nodemon src/server.js",
    "start": "node scripts/prepareSchema.js && node src/server.js",
    "build": "node scripts/prepareSchema.js && prisma generate && prisma db push --accept-data-loss",
    "db:push": "node scripts/prepareSchema.js && prisma db push",
    "db:generate": "node scripts/prepareSchema.js && prisma generate",
    "db:seed": "node scripts/prepareSchema.js && node prisma/seed.js",
    "db:studio": "prisma studio",
    "set:admin": "node scripts/setAdminCredentials.js"
  },
  "keywords": [
    "beauty",
    "salon",
    "booking",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
