// Prisma schema para Studio de Beleza / Sobrancelhas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // "ADMIN" | "ESTILISTA"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stylist      Stylist?
}

model Stylist {
  id           Int              @id @default(autoincrement())
  userId       Int?             @unique
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  bio          String?
  photoUrl     String?
  phone        String?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  services     StylistService[]
  schedules    Schedule[]
  dateSchedules DateSchedule[]
  appointments Appointment[]
  portfolio    PortfolioItem[]

  // Configurações e Autonomia do Studio (gerenciadas pela Letícia)
  address                 String?  @default("Condomínio Altos da Theodomiro 2, 2435")
  addressDetails          String?  @default("2ª portaria (último prédio da rua), Bloco 6, Apê 652 – 5º andar")
  instagram               String?  @default("@leticia_r.oliveira")
  facebook                String?
  twitter                 String?
  tiktok                  String?
  otherSocials            String?  // JSON string para outras redes adicionadas dinamicamente
  headline                String?  @default("Cuidando do seu olhar com amor, visagismo & dedicação.")
  greetingBadge           String?  @default("Prazer, sou a Letícia! ✨ • 25 Anos")
  heroQuote               String?  @default("Hoje, meu trabalho vai muito além de um procedimento estético. É sobre valorizar a beleza individual, respeitar cada expressão e contribuir para que cada mulher se sinta ainda mais bonita e confiante.")
  aboutTitle              String?  @default("Um refúgio de acolhimento e cuidado desenhado para realçar você.")
  aboutDescription        String?  @default("O Studio Letícia Oliveira nasceu da paixão pelo visagismo facial e pela crença de que cada rosto possui uma harmonia única que merece ser respeitada.")
  experienceYears         String?  @default("Desde 2023 · Beleza & Visagismo")
  pixKey                  String?  @default("5551995037223")
  pixType                 String?  @default("Telefone") // "Telefone", "CPF", "Email", "Aleatória"
  cancellationNoticeHours Int?     @default(24)
  cancellationFeePercent  Int?     @default(50)
  customPolicyText        String?  @default("Cancelamentos ou remarcações devem ser realizados com 24h de antecedência. Após esse prazo ou em caso de não comparecimento, é cobrado 50% do valor do procedimento, referente ao horário reservado exclusivamente para você.")
  bufferMinutes           Int?     @default(0) // Intervalo entre atendimentos para higienização
}

model Service {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  price           Float
  durationMinutes Int              // Ex: 10, 20, 30, 60
  category        String?          @default("Geral")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stylists        StylistService[]
  appointments    Appointment[]
}

model StylistService {
  id        Int     @id @default(autoincrement())
  stylistId Int
  serviceId Int
  active    Boolean @default(true)
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([stylistId, serviceId])
}

// Horário padrão semanal (Fallback)
model Schedule {
  id         Int     @id @default(autoincrement())
  stylistId  Int
  dayOfWeek  Int     // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  startTime  String  // "09:00"
  endTime    String  // "19:00"
  breakStart String? // "12:00"
  breakEnd   String? // "13:00"
  isActive   Boolean @default(true)
  stylist    Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
}

// Escala por data específica / Lote mensal / Folgas e plantões
model DateSchedule {
  id         Int      @id @default(autoincrement())
  stylistId  Int
  date       String   // "YYYY-MM-DD"
  isOpen     Boolean  @default(true) // true = Atende neste dia; false = Fechado / Folga / Escala obrigatória
  startTime  String?  // Ex: "09:00" (se nulo, herda o padrão do dia da semana)
  endTime    String?  // Ex: "19:00"
  breakStart String?  // Ex: "12:00"
  breakEnd   String?  // Ex: "13:00"
  note       String?  // Ex: "Escala Externa", "Plantão", "Folga", "Horário Especial"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  stylist    Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, date])
}

model Appointment {
  id            Int      @id @default(autoincrement())
  clientName    String
  clientPhone   String
  clientEmail   String?
  stylistId     Int
  serviceId     Int
  date          String   // "YYYY-MM-DD"
  startTime     String   // "09:00"
  endTime       String   // "09:30"
  status        String   @default("CONFIRMADO") // "PENDENTE", "CONFIRMADO", "CANCELADO", "CONCLUIDO"
  paymentMethod String   @default("PRESENCIAL") // "PRESENCIAL", "ONLINE"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stylist       Stylist  @relation(fields: [stylistId], references: [id], onDelete: Restrict)
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model PortfolioItem {
  id          Int      @id @default(autoincrement())
  stylistId   Int?
  imageUrl    String
  title       String
  category    String   // "Design", "Henna", "Lamination", "Facial"
  description String?
  createdAt   DateTime @default(now())
  stylist     Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)
}

// Campanhas de Bônus e Benefícios lançadas pela Administradora
model BonusCampaign {
  id            Int                @id @default(autoincrement())
  title         String             // Ex: "Bônus Especial de Design com Henna"
  description   String?            // Detalhes do bônus
  serviceId     Int?               // Procedimento associado (opcional)
  discountType  String             @default("PERCENT") // "PERCENT", "FIXED", "GIFT"
  discountValue Float              @default(0) // Ex: 15 (% ou R$)
  giftName      String?            // Ex: "Epilação do buço gratuita"
  active        Boolean            @default(true) // Oculto ou Ativado
  startDate     String?            // "YYYY-MM-DD"
  endDate       String?            // "YYYY-MM-DD"
  badgeText     String?            @default("Tempo Limitado") // "Exclusivo", "Mês de Aniversário"
  imageUrl      String?            // Foto / banner do bônus
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  applications  BonusApplication[]
}

// Inscrições e Solicitações de Bônus feitas pelas clientes (sujeitas a aprovação da dona)
model BonusApplication {
  id          Int           @id @default(autoincrement())
  campaignId  Int
  clientName  String
  clientPhone String        // Telefone para contato e trava de 15 dias
  clientEmail String?
  serviceName String?       // Procedimento desejado
  status      String        @default("PENDENTE") // "PENDENTE", "APROVADO", "RECUSADO", "UTILIZADO"
  adminNote   String?       // Observação da administradora
  code        String        @unique // Código único: BONUS-1234
  approvedAt  DateTime?
  appliedAt   DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  campaign    BonusCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
